{
  "name": "handymd-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run build:sdk && bun run build:site && bun run build:app",
    "build:sdk": "bun --filter='@21stware/handymd' run build",
    "build:app": "bun --filter='handymd-app' run build",
    "build:site": "bun --filter='handymd-site' run build",
    "dev:app": "bun --filter='handymd-app' run dev",
    "dev:site": "bun --filter='handymd-site' run dev",
    "test": "bun --filter='@21stware/handymd' run test",
    "bench": "bun --filter='@21stware/handymd' run bench",
    "typecheck": "bun --filter='*' run typecheck",
    "e2e": "bun --filter='@21stware/handymd' run e2e"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
