{
  "name": "@21stware/handymd",
  "version": "0.1.0",
  "description": "Bear-style source-fidelity Markdown editor SDK (@21stware/handymd) — the document IS the markdown source; markers are selectively concealed by cursor position.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "bench": "bun test test/perf.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "bun run scripts/e2e.ts",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "keywords": [
    "markdown",
    "editor",
    "prosemirror",
    "bear",
    "wysiwyg",
    "conceal",
    "live-preview",
    "source-fidelity"
  ],
  "license": "MIT",
  "dependencies": {
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.3",
    "prosemirror-state": "^1.4.3",
    "prosemirror-transform": "^1.10.4",
    "prosemirror-view": "^1.41.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.11",
    "@types/bun": "^1.3.14",
    "mermaid": "^11.12.2",
    "playwright": "^1.62.1",
    "shiki": "^4.4.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "mermaid": ">=10.0.0",
    "shiki": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21stware/handymd.git"
  },
  "homepage": "https://21stware.github.io/handymd/",
  "bugs": {
    "url": "https://github.com/21stware/handymd/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
