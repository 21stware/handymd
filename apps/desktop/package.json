{
  "name": "handymd-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot index.html",
    "build": "bun run scripts/build.ts",
    "tauri": "bunx --bun @tauri-apps/cli",
    "tauri:dev": "bunx --bun @tauri-apps/cli dev",
    "tauri:build": "bunx --bun @tauri-apps/cli build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "bun run scripts/check.ts",
    "shot": "bun run scripts/shot.ts"
  },
  "dependencies": {
    "@21stware/handymd": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "prosemirror-state": "^1.4.3",
    "shiki": "^4.4.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.14",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3"
  }
}
