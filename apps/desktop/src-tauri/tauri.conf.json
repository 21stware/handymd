{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Handy",
  "mainBinaryName": "Handy",
  "version": "0.1.0",
  "identifier": "com.21stware.handymd",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun --hot index.html --port 3000",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Handy",
        "width": 1080,
        "height": 680,
        "minWidth": 720,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 18 },
        "backgroundColor": "#F7F7F7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/AppIcon.icon"
    ],
    "category": "Productivity",
    "shortDescription": "Minimal Markdown editor with iCloud-synced vault",
    "longDescription": "Handy is a source-fidelity Markdown editor. Notes live in a single SQLite vault (vault.mdb) that syncs through iCloud Drive."
  },
  "plugins": {}
}
